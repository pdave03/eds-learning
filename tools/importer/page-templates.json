{
  "metadata": {
    "projectType": "doc"
  },
  "templates": [
    {
      "name": "homepage",
      "urls": [
        "https://wknd.site/us/en.html"
      ],
      "coverageGaps": [],
      "description": "WKND homepage: header, hero carousel, featured article (image+text), recent articles (cards), climbing NZ promo (image+text), next adventures (cards), footer.",
      "blocks": [
        {
          "name": "carousel-hero",
          "instances": [
            "div.carousel.cmp-carousel--hero"
          ]
        },
        {
          "name": "columns-featured",
          "instances": [
            "div.teaser.cmp-teaser--featured"
          ]
        },
        {
          "name": "columns-imgbottom",
          "instances": [
            "div.teaser.cmp-teaser--imagebottom"
          ]
        },
        {
          "name": "cards-article",
          "instances": [
            "div.image-list.list"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Hero Carousel",
          "selector": "div.carousel.cmp-carousel--hero",
          "style": null,
          "blocks": [
            "carousel-hero"
          ],
          "defaultContent": []
        },
        {
          "id": "section-2",
          "name": "Featured Article",
          "selector": "div.teaser.cmp-teaser--featured",
          "style": null,
          "blocks": [
            "columns-featured"
          ],
          "defaultContent": []
        },
        {
          "id": "section-3",
          "name": "Recent Articles",
          "selector": "main.cmp-layout-container--fixed:nth-of-type(1)",
          "style": null,
          "blocks": [
            "cards-article"
          ],
          "defaultContent": [
            "div.title.cmp-title--underline",
            "div.button.cmp-button--primary"
          ]
        },
        {
          "id": "section-4",
          "name": "Next Adventures",
          "selector": "main.cmp-layout-container--fixed:nth-of-type(2)",
          "style": null,
          "blocks": [
            "columns-imgbottom",
            "cards-article"
          ],
          "defaultContent": [
            "div.title",
            "div.button.cmp-button--primary"
          ]
        }
      ]
    },
